---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translate = translatePath(Astro.url);

const title = t('notfound.meta_title');
const description = t('notfound.meta_desc');
---

<Layout title={title} description={description}>
	<section class="quiet-inner-page quiet-inner-hero relative isolate overflow-hidden pb-24 pt-32 sm:pt-36 lg:pt-40">
		<div class="container mx-auto px-4 text-center">
			<p class="font-display text-8xl font-extrabold text-[var(--accent-strong)]/80">404</p>
			<h1 class="mt-6 font-display text-3xl font-extrabold text-ink sm:text-5xl text-balance">
				{t('notfound.heading')}
			</h1>
			<p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-ink-muted">
				{t('notfound.text')}
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<Button href={translate('/')} variant="primary">
					<span>{t('nav.home')}</span>
				</Button>
				<Button href={translate('/#apps')} variant="outline">
					<span>{t('hero.apps_catalog')}</span>
				</Button>
			</div>
		</div>
	</section>
</Layout>
