---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import favicon from '../../public/favicon.svg';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';
import { fetchLatestRelease } from '../utils/github';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translate = translatePath(Astro.url);

const release = await fetchLatestRelease('bit-Tecnologies/bit_hub', lang).catch(() => null);
const downloadUrl = release?.url || translate('/bit-hub');

const title = 'bit Tecnologies — Экосистема удобных приложений';
const description = 'bit Tecnologies разрабатывает нативные, быстрые и приватные приложения для Android. Никакой телеметрии и рекламы.';

const schema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "bit Tecnologies",
	"url": "https://cybernattor.github.io",
	"description": description,
	"potentialAction": {
		"@type": "SearchAction",
		"target": "https://cybernattor.github.io/search?q={search_term_string}",
		"query-input": "required name=search_term_string"
	}
};

const productCards = [
	{
		href: translate('/bit-hub'),
		name: t('app.bithub'),
		status: { label: 'Beta', color: 'emerald' as const },
		description: t('app.bithub_desc'),
		requirements: 'Android 10+',
		size: release?.size || '~100 МБ',
		iconImage: '/favicon.svg',
	},
	{
		href: translate('/bit-delta'),
		name: t('app.bitdelta'),
		status: { label: 'Beta', color: 'emerald' as const },
		description: t('app.bitdelta_desc'),
		requirements: 'Android 12+',
		size: '~5 МБ',
		iconBgColor: 'from-violet-500 via-fuchsia-500 to-rose-500',
		icon: 'delta',
	},
	{
		href: translate('/bit-record'),
		name: t('app.bitrecord'),
		status: { label: t('app.in_development'), color: 'blue' as const },
		description: t('app.bitrecord_desc'),
		requirements: 'Android 11+',
		size: '~3 МБ',
		iconBgColor: 'from-rose-500 via-orange-500 to-amber-400',
		icon: 'record',
	},
	{
		href: translate('/bit-together'),
		name: t('app.bittogether'),
		status: { label: t('app.in_development'), color: 'blue' as const },
		description: t('app.bittogether_desc'),
		requirements: 'Android 10+',
		size: 'TBA',
		iconBgColor: 'from-cyan-500 via-sky-500 to-blue-600',
		icon: 'together',
	},
	{
		href: translate('/bit-launcher'),
		name: t('app.bitlauncher'),
		status: { label: t('app.in_development'), color: 'blue' as const },
		description: t('app.bitlauncher_desc'),
		requirements: 'Android 10+',
		size: 'TBA',
		iconBgColor: 'from-emerald-500 via-teal-500 to-sky-500',
		icon: 'launcher',
	},
];
---

<Layout title={title} description={description} schema={schema}>
	<section class="relative isolate overflow-hidden pt-32 sm:pt-36 lg:pt-40">
		<div class="liquid-canvas absolute inset-0 -z-10"></div>
		<div class="container mx-auto px-4 pb-16 md:pb-24">
			<div class="grid items-center gap-10 lg:grid-cols-[1.02fr_0.98fr]">
				<div class="reveal max-w-3xl">
					<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/70 bg-white/55 px-3 py-2 text-xs font-bold uppercase tracking-[0.18em] text-slate-600 shadow-sm backdrop-blur-2xl dark:border-white/10 dark:bg-white/8 dark:text-slate-300">
						<span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_18px_rgba(52,211,153,0.8)]"></span>
						Экосистема Android-приложений
					</div>
					<h1 class="max-w-4xl font-display text-5xl font-extrabold leading-[0.96] text-slate-950 dark:text-white sm:text-6xl lg:text-7xl">
						{t('hero.title')}
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300 sm:text-xl">
						{t('hero.subtitle')}
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
						<Button href={downloadUrl} variant="primary" download>
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M17 3H7c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14l-4-4h3V9h2v4h3l-4 4z"/>
							</svg>
							<span>{t('hero.download_hub')}</span>
						</Button>
						<Button href="#apps" variant="outline">
							<span>{t('hero.apps_catalog')}</span>
						</Button>
					</div>
					<div class="mt-5 flex max-w-fit items-center gap-3 rounded-2xl border border-white/75 bg-white/52 px-3 py-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.8)] backdrop-blur-xl dark:border-white/12 dark:bg-white/8">
						<Image src={favicon} alt="" class="h-9 w-9 rounded-xl" />
						<div class="min-w-0">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{t('hero.hub_release_label')}</p>
							<p class="truncate font-mono text-sm font-extrabold text-slate-900 dark:text-white">{release?.version || t('hero.hub_release_fallback')}</p>
						</div>
					</div>
					<div class="mt-5 flex flex-wrap gap-3 text-sm font-bold text-slate-600 dark:text-slate-300">
						<span class="liquid-chip">{t('hero.no_trackers')}</span>
						<span class="liquid-chip">Open source</span>
						<span class="liquid-chip">MIT</span>
					</div>
				</div>

				<div class="reveal-right relative">
					<div class="liquid-device mx-auto max-w-[520px]">
						<div class="flex items-center justify-between border-b border-white/50 px-5 py-4 dark:border-white/10">
							<div class="flex items-center gap-3">
								<Image src={favicon} alt="bit Hub" class="h-11 w-11 rounded-2xl" />
								<div>
									<p class="font-display text-lg font-extrabold text-slate-950 dark:text-white">bit Hub</p>
									<p class="font-mono text-xs text-slate-500 dark:text-slate-400">privacy build ready</p>
								</div>
							</div>
							<span class="rounded-full bg-emerald-400/20 px-3 py-1 text-xs font-extrabold text-emerald-700 ring-1 ring-emerald-400/30 dark:text-emerald-200">Live</span>
						</div>
						<div class="grid gap-3 p-5">
							<div class="liquid-row">
								<span>Телеметрия</span>
								<strong>Отключена</strong>
							</div>
							<div class="liquid-row">
								<span>Реклама</span>
								<strong>Нет</strong>
							</div>
							<div class="liquid-row">
								<span>Размер релиза</span>
								<strong>{release?.size || '~100 МБ'}</strong>
							</div>
							<div class="liquid-preview">
								<div class="flex items-center justify-between">
									<span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Стек приложений</span>
									<span class="font-mono text-xs text-slate-400">05 модулей</span>
								</div>
								<div class="mt-4 grid grid-cols-5 gap-2">
									{productCards.map((product) => (
										<a
											href={product.href}
											aria-label={product.name}
											class="group flex aspect-square min-w-0 flex-col items-center justify-center gap-1.5 rounded-2xl bg-white/70 p-2 text-center shadow-sm ring-1 ring-white/70 backdrop-blur-xl transition duration-200 hover:-translate-y-1 hover:bg-white/85 hover:shadow-md dark:bg-white/10 dark:ring-white/10 dark:hover:bg-white/15"
										>
											<span class={`flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br ${product.iconBgColor || 'from-emerald-500 via-teal-500 to-sky-500'} text-white shadow-lg shadow-slate-900/10`}>
												{product.iconImage ? (
													<img src={product.iconImage} alt="" class="h-5 w-5 rounded-md" loading="lazy" />
												) : (
													<>
														{product.icon === 'delta' && <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.5,5.5C14.59,5.5 15.5,4.58 15.5,3.5C15.5,2.38 14.59,1.5 13.5,1.5C12.39,1.5 11.5,2.38 11.5,3.5C11.5,4.58 12.39,5.5 13.5,5.5M9.89,19.38L10.89,15L13,17V23H15V15.5L12.89,13.5L13.5,10.5C14.79,12 16.79,13 19,13V11C17.09,11 15.5,10 14.69,8.58L13.69,7C13.29,6.38 12.69,6 12,6C11.69,6 11.5,6.08 11.19,6.19L6,8.28V13H8V9.58L9.79,8.88L8.19,17L3.29,16L2.89,18L9.89,19.38Z"/></svg>}
														{product.icon === 'record' && <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/></svg>}
														{product.icon === 'together' && <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16,11C17.66,11 18.99,9.66 18.99,8C18.99,6.34 17.66,5 16,5C14.34,5 13,6.34 13,8C13,9.66 14.34,11 16,11M8,11C9.66,11 10.99,9.66 10.99,8C10.99,6.34 9.66,5 8,5C6.34,5 5,6.34 5,8C5,9.66 6.34,11 8,11M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M16,13C15.71,13 15.38,13.02 15.03,13.05C16.19,13.89 17,15.02 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13Z"/></svg>}
														{product.icon === 'launcher' && <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12,2A5,5 0 0,0 7,7C7,8.76 7.91,10.31 9.28,11.2C8.47,12.73 8,14.69 8,17H10C10,14.83 10.45,13.04 11.2,11.79C11.46,11.92 11.73,12 12,12C12.27,12 12.54,11.92 12.8,11.79C13.55,13.04 14,14.83 14,17H16C16,14.69 15.53,12.73 14.72,11.2C16.09,10.31 17,8.76 17,7A5,5 0 0,0 12,2M12,4A3,3 0 0,1 15,7A3,3 0 0,1 12,10A3,3 0 0,1 9,7A3,3 0 0,1 12,4M6,18L4,22H8L10,18H6M14,18L16,22H20L18,18H14Z"/></svg>}
													</>
												)}
											</span>
											<span class="w-full truncate text-[10px] font-extrabold leading-none text-slate-700 dark:text-slate-200">{product.name.replace('bit ', '')}</span>
											<span class={`h-1.5 w-1.5 rounded-full ${product.status.color === 'emerald' ? 'bg-emerald-400' : 'bg-sky-400'} shadow-[0_0_12px_currentColor]`}></span>
										</a>
									))}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 md:py-16">
		<div class="container mx-auto px-4">
			<div class="liquid-strip grid gap-5 p-4 sm:grid-cols-2 lg:grid-cols-4">
				<div class="p-4">
					<p class="font-display text-4xl font-extrabold text-slate-950 dark:text-white">0</p>
					<p class="mt-1 text-sm font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{t('stats.trackers')}</p>
				</div>
				<div class="p-4">
					<p class="font-display text-4xl font-extrabold text-slate-950 dark:text-white">100%</p>
					<p class="mt-1 text-sm font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{t('stats.opensource')}</p>
				</div>
				<div class="p-4">
					<p class="font-display text-4xl font-extrabold text-slate-950 dark:text-white">MIT</p>
					<p class="mt-1 text-sm font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{t('stats.license')}</p>
				</div>
				<div class="p-4">
					<p class="font-display text-4xl font-extrabold text-slate-950 dark:text-white">{release?.size || '~100'}</p>
					<p class="mt-1 text-sm font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{t('stats.size')}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24">
		<div class="container mx-auto px-4">
			<div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr]">
				<div class="reveal-left">
					<p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700 dark:text-emerald-300">{t('advantages.title')}</p>
					<h2 class="font-display text-3xl font-extrabold leading-tight text-slate-950 dark:text-white sm:text-5xl">
						Приватность выглядит спокойнее, когда она встроена в продукт.
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
						Сайт теперь держится на простых доказательствах: открытый код, ноль рекламы, нативная скорость и понятная экосистема приложений.
					</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="liquid-card p-6 reveal stagger-1">
						<div class="liquid-icon bg-emerald-400/20 text-emerald-700 dark:text-emerald-200">
							<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z"/></svg>
						</div>
						<h3 class="mt-5 font-display text-xl font-extrabold text-slate-950 dark:text-white">Полная приватность</h3>
						<p class="mt-3 text-slate-600 dark:text-slate-300">Никакой телеметрии, аналитики или рекламных трекеров.</p>
					</div>
					<div class="liquid-card p-6 reveal stagger-2">
						<div class="liquid-icon bg-sky-400/20 text-sky-700 dark:text-sky-200">
							<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M13,2.03V4.05C17.39,4.59 20.5,8.58 19.96,12.97C19.5,16.61 16.64,19.5 13,19.93V21.93C18.5,21.38 22.5,16.5 21.95,11C21.5,6.25 17.73,2.5 13,2.03M11,2.06C9.05,2.25 7.19,3 5.67,4.26L7.1,5.74C8.22,4.84 9.57,4.26 11,4.06V2.06M4.26,5.67C3,7.19 2.25,9.04 2.05,11H4.05C4.24,9.58 4.8,8.23 5.69,7.1L4.26,5.67M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/></svg>
						</div>
						<h3 class="mt-5 font-display text-xl font-extrabold text-slate-950 dark:text-white">Нативная скорость</h3>
						<p class="mt-3 text-slate-600 dark:text-slate-300">Kotlin и Jetpack Compose без лишней прослойки.</p>
					</div>
					<div class="liquid-card p-6 reveal stagger-3">
						<div class="liquid-icon bg-violet-400/20 text-violet-700 dark:text-violet-200">
							<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/></svg>
						</div>
						<h3 class="mt-5 font-display text-xl font-extrabold text-slate-950 dark:text-white">Открытый код</h3>
						<p class="mt-3 text-slate-600 dark:text-slate-300">Код можно проверить, форкнуть и улучшить.</p>
					</div>
					<div class="liquid-card p-6 reveal stagger-4">
						<div class="liquid-icon bg-amber-400/20 text-amber-700 dark:text-amber-200">
							<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"/></svg>
						</div>
						<h3 class="mt-5 font-display text-xl font-extrabold text-slate-950 dark:text-white">Ноль рекламы</h3>
						<p class="mt-3 text-slate-600 dark:text-slate-300">Интерфейс остается чистым и не торгует вниманием.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="apps" class="py-16 md:py-24">
		<div class="container mx-auto px-4">
			<div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
				<div>
					<p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.2em] text-sky-700 dark:text-sky-300">Продукты</p>
					<h2 class="font-display text-3xl font-extrabold text-slate-950 dark:text-white sm:text-5xl">{t('home.apps')}</h2>
					<p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{t('home.apps_subtitle')}</p>
				</div>
				<Button href={downloadUrl} variant="outline" download>
					<span>Скачать bit Hub</span>
				</Button>
			</div>

			<div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
				{productCards.map((product, index) => (
					<div class={`reveal stagger-${Math.min(index + 1, 6)}`}>
						<AppCard
							href={product.href}
							name={product.name}
							status={product.status}
							description={product.description}
							requirements={product.requirements}
							size={product.size}
							iconImage={product.iconImage}
							iconBgColor={product.iconBgColor}
						>
							{product.icon === 'delta' && <svg slot="icon" class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M13.5,5.5C14.59,5.5 15.5,4.58 15.5,3.5C15.5,2.38 14.59,1.5 13.5,1.5C12.39,1.5 11.5,2.38 11.5,3.5C11.5,4.58 12.39,5.5 13.5,5.5M9.89,19.38L10.89,15L13,17V23H15V15.5L12.89,13.5L13.5,10.5C14.79,12 16.79,13 19,13V11C17.09,11 15.5,10 14.69,8.58L13.69,7C13.29,6.38 12.69,6 12,6C11.69,6 11.5,6.08 11.19,6.19L6,8.28V13H8V9.58L9.79,8.88L8.19,17L3.29,16L2.89,18L9.89,19.38Z"/></svg>}
							{product.icon === 'record' && <svg slot="icon" class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/></svg>}
							{product.icon === 'together' && <svg slot="icon" class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16,11C17.66,11 18.99,9.66 18.99,8C18.99,6.34 17.66,5 16,5C14.34,5 13,6.34 13,8C13,9.66 14.34,11 16,11M8,11C9.66,11 10.99,9.66 10.99,8C10.99,6.34 9.66,5 8,5C6.34,5 5,6.34 5,8C5,9.66 6.34,11 8,11M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M16,13C15.71,13 15.38,13.02 15.03,13.05C16.19,13.89 17,15.02 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13Z"/></svg>}
							{product.icon === 'launcher' && <svg slot="icon" class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12,2A5,5 0 0,0 7,7C7,8.76 7.91,10.31 9.28,11.2C8.47,12.73 8,14.69 8,17H10C10,14.83 10.45,13.04 11.2,11.79C11.46,11.92 11.73,12 12,12C12.27,12 12.54,11.92 12.8,11.79C13.55,13.04 14,14.83 14,17H16C16,14.69 15.53,12.73 14.72,11.2C16.09,10.31 17,8.76 17,7A5,5 0 0,0 12,2M12,4A3,3 0 0,1 15,7A3,3 0 0,1 12,10A3,3 0 0,1 9,7A3,3 0 0,1 12,4M6,18L4,22H8L10,18H6M14,18L16,22H20L18,18H14Z"/></svg>}
						</AppCard>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="compatibility" class="py-16 md:py-24">
		<div class="container mx-auto px-4">
			<div class="liquid-panel grid gap-8 p-6 sm:p-8 lg:grid-cols-2 lg:p-10">
				<div>
					<p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.2em] text-violet-700 dark:text-violet-300">Устройства</p>
					<h2 class="font-display text-3xl font-extrabold text-slate-950 dark:text-white sm:text-5xl">{t('home.compatibility')}</h2>
					<p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{t('home.compatibility_subtitle')}</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="rounded-[1.5rem] bg-white/55 p-5 ring-1 ring-white/70 backdrop-blur-2xl dark:bg-white/8 dark:ring-white/10">
						<h3 class="font-display text-xl font-extrabold text-slate-950 dark:text-white">{t('home.requirements_title')}</h3>
						<ul class="mt-4 space-y-3 text-sm font-semibold text-slate-600 dark:text-slate-300">
							<li>Android 10 (API 29) и выше</li>
							<li>2 ГБ ОЗУ рекомендуется</li>
							<li>ARMv7 или ARM64</li>
						</ul>
					</div>
					<div class="rounded-[1.5rem] bg-white/55 p-5 ring-1 ring-white/70 backdrop-blur-2xl dark:bg-white/8 dark:ring-white/10">
						<h3 class="font-display text-xl font-extrabold text-slate-950 dark:text-white">{t('home.testing_title')}</h3>
						<ul class="mt-4 space-y-3 text-sm font-semibold text-slate-600 dark:text-slate-300">
							<li>Протестировано на Android 16</li>
							<li>Поддержка бюджетных устройств</li>
							<li>Оптимизация батареи</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="download" class="pb-20 pt-12 md:pb-28">
		<div class="container mx-auto px-4">
			<div class="liquid-cta mx-auto max-w-5xl p-7 text-center sm:p-10 md:p-14">
				<Image src={favicon} alt="bit Hub" class="mx-auto mb-6 h-16 w-16 rounded-3xl shadow-xl shadow-emerald-500/15" />
				<h2 class="font-display text-3xl font-extrabold text-slate-950 dark:text-white sm:text-5xl">Готовы попробовать?</h2>
				<p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
					Скачайте bit Hub и держите всю экосистему BIT под рукой: без рекламы, без телеметрии, без лишнего шума.
				</p>
				<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<Button href={downloadUrl} variant="primary" download>
						<span>{t('hero.download_hub')}</span>
					</Button>
					<Button href="https://github.com/bit-Tecnologies/bit-site" variant="outline" target="_blank" rel="noopener noreferrer">
						<span>GitHub</span>
					</Button>
				</div>
				<p class="mt-5 font-mono text-sm text-slate-500 dark:text-slate-400">Размер: {release?.size || '~100 МБ'} / Android 10+ / Open source</p>
			</div>
		</div>
	</section>
</Layout>
