---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../../public/favicon.svg';
import { getLangFromUrl, translatePath } from '../i18n/utils';
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: Record<string, any>;
}

const { title, description, image = "/og-bit-hub.svg", schema } = Astro.props;
// Get language from localized path or query parameter
const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');

// Build alternate language URLs with query parameters
const currentPath = Astro.url.pathname;
const hash = Astro.url.hash;
const translate = translatePath(Astro.url);

// Create URLs for language switching
const ruURL = new URL(`${translate(currentPath, 'ru')}${hash}`, Astro.site || 'http://localhost:4321');
const enURL = new URL(`${translate(currentPath, 'en')}${hash}`, Astro.site || 'http://localhost:4321');

const defaultSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "bit Tecnologies",
	"url": "https://cybernattor.github.io", // Using github pages or custom domain as reference
	"logo": "https://cybernattor.github.io/favicon.svg",
	"sameAs": [
		"https://github.com/cybernattor"
	]
};

const jsonLd = schema || defaultSchema;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
		<meta name="author" content="bit Tecnologies" />
		<meta name="keywords" content="bit Tecnologies, android, privacy, mobile apps, kotlin, jetpack compose" />
		<meta name="google-site-verification" content="NRxPEtJF7O-XeZhsTMAgjTgWa_F5IxHUSkRi4yZDH_8" />

		<!-- JSON-LD Schema -->
		<script type="application/ld+json" is:inline>{JSON.stringify(jsonLd)}</script>

		<!-- Open Graph Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="bit Tecnologies Logo" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content="bit Tecnologies" />

		<!-- Canonical & Hreflang -->
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="alternate" hreflang="ru" href={ruURL.href} />
		<link rel="alternate" hreflang="en" href={enURL.href} />
		<link rel="alternate" hreflang="x-default" href={ruURL.href} />

		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Preconnect to font origins -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Preload font stylesheet for faster rendering -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" />
		<!-- Font stylesheet -->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" />
		<!-- DNS prefetch for external resources -->
		<link rel="dns-prefetch" href="https://cybernattor.github.io" />

		<ClientRouter />

    <!-- Inline script to prevent FOUC with dark mode -->
    <script is:inline>
      function applyTheme() {
        try {
          const theme = localStorage.getItem('color-theme');
          if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark')
          }
        } catch {
          // Fallback to system preference if localStorage is not available
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      }

      // Initial load
      applyTheme();

      // Handle View Transitions
      document.addEventListener('astro:before-swap', (ev) => {
        try {
          const theme = localStorage.getItem('color-theme');
          const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            ev.newDocument.documentElement.classList.add('dark');
          } else {
            ev.newDocument.documentElement.classList.remove('dark');
          }
        } catch {
          // Fallback to system preference
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            ev.newDocument.documentElement.classList.add('dark');
          }
        }
      });

      // Secondary check for robustness
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
	</head>
	<body class="bg-[#f6f7f3] dark:bg-[#0b0d10] text-slate-900 dark:text-slate-100 font-sans antialiased transition-colors duration-300">
		<!-- Skip link for keyboard navigation -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50 focus:outline-none focus:ring-2 focus:ring-blue-500">
			Перейти к основному содержимому
		</a>
		<div class="min-h-screen flex flex-col">
			<!-- Header Component -->
			<Header />

			<!-- Main Content -->
			<main id="main-content" class="flex-1" tabindex="-1">
				<slot />
			</main>

			<!-- Footer Component -->
			<Footer />
		</div>

		<!-- Dynamic Translation System -->
		<script>
			import '../i18n/client';
		</script>

		<!-- Scroll Reveal Observer -->
		<script>
		let currentObserver: IntersectionObserver | null = null;

			function setupRevealObserver() {
				if (currentObserver) currentObserver.disconnect();

				const reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');

				currentObserver = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				});

				reveals.forEach(el => currentObserver!.observe(el));
			}

			// Cursor glow effect
			function setupCursorGlow() {
				document.querySelectorAll('.cursor-glow').forEach(el => {
					el.addEventListener('mousemove', (e: Event) => {
						const mouseEvent = e as MouseEvent;
						const rect = (el as HTMLElement).getBoundingClientRect();
						const x = mouseEvent.clientX - rect.left;
						const y = mouseEvent.clientY - rect.top;
						(el as HTMLElement).style.setProperty('--glow-x', `${x}px`);
						(el as HTMLElement).style.setProperty('--glow-y', `${y}px`);
						const before = (el as HTMLElement).querySelector('.glow-indicator') as HTMLElement;
						if (before) {
							before.style.left = `${x}px`;
							before.style.top = `${y}px`;
						}
					});
			});
			}

			// Setup on initial load
			setupRevealObserver();
			setupCursorGlow();

			// Re-setup after View Transitions
			document.addEventListener('astro:after-swap', () => {
				setupRevealObserver();
				setupCursorGlow();
			});
		</script>
	</body>
</html>
