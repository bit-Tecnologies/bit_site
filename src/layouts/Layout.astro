---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../../public/favicon.svg';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';
import '../styles/global.css';

/* eslint-disable astro/no-set-html-directive */

export interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: Record<string, any>;
}

const { title, description, image = "/og-bit-hub.png", schema } = Astro.props;
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site || 'http://localhost:4321').href;
// Get language from localized path or query parameter
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');

// Build alternate language URLs with query parameters
const currentPath = Astro.url.pathname;
const hash = Astro.url.hash;
const translate = translatePath(Astro.url);

// Create URLs for language switching
const ruURL = new URL(`${translate(currentPath, 'ru')}${hash}`, Astro.site || 'http://localhost:4321');
const enURL = new URL(`${translate(currentPath, 'en')}${hash}`, Astro.site || 'http://localhost:4321');

const defaultSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "bit Tecnologies",
	"url": "https://bit-tecnologies.pages.dev",
	"logo": "https://bit-tecnologies.pages.dev/favicon.svg",
	"sameAs": [
		"https://github.com/bit-Tecnologies"
	]
};

const jsonLd = schema || defaultSchema;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
		<meta name="author" content="bit Tecnologies" />
		<meta name="google-site-verification" content="NRxPEtJF7O-XeZhsTMAgjTgWa_F5IxHUSkRi4yZDH_8" />

		<!-- JSON-LD Schema -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

		<!-- Open Graph Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="bit Tecnologies Logo" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:site_name" content="bit Tecnologies" />

		<!-- Canonical & Hreflang -->
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="alternate" hreflang="ru" href={ruURL.href} />
		<link rel="alternate" hreflang="en" href={enURL.href} />
		<link rel="alternate" hreflang="x-default" href={ruURL.href} />

		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Preconnect to font origins -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Non-blocking font loading -->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" media="print" onload="this.setAttribute('media','all')" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" /></noscript>

		<ClientRouter />

    <!-- Inline script to prevent FOUC with dark mode -->
    <script is:inline>
      (function(){try{var t=localStorage.getItem('color-theme');var d=t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme:dark)').matches);document.documentElement.classList.toggle('dark',d)}catch{document.documentElement.classList.toggle('dark',matchMedia('(prefers-color-scheme:dark)').matches)}})()
    </script>
    <!-- JS availability guard: reveal animations only run when JS is present -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Apply dark mode during View Transitions -->
    <script is:inline>
      document.addEventListener('astro:before-swap',function(ev){try{var t=localStorage.getItem('color-theme');var d=t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme:dark)').matches);ev.newDocument.documentElement.classList.toggle('dark',d)}catch{ev.newDocument.documentElement.classList.toggle('dark',matchMedia('(prefers-color-scheme:dark)').matches)}});
    </script>
	</head>
		<body class="quiet-body text-slate-900 dark:text-slate-100 font-sans antialiased transition-colors duration-300">
		<!-- Skip link for keyboard navigation -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50 focus:outline-none focus:ring-2 focus:ring-blue-500" data-i18n="layout.skip_link">
			{t('layout.skip_link')}
		</a>
		<div class="min-h-screen flex flex-col">
			<!-- Header Component -->
			<Header />

			<!-- Main Content -->
			<main id="main-content" class="flex-1" tabindex="-1">
				<slot />
			</main>

			<!-- Footer Component -->
			<Footer />
		</div>

		<!-- Dynamic Translation System -->
		<script>
			import '../i18n/client';
		</script>

		<!-- Live Release Updater -->
		<script>
			import '../scripts/release';
		</script>

		<!-- Scroll Reveal Observer -->
		<script>
		let currentObserver: IntersectionObserver | null = null;

			function setupRevealObserver() {
				if (currentObserver) currentObserver.disconnect();

				const reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');

				currentObserver = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				});

				reveals.forEach(el => currentObserver!.observe(el));
			}

			// Setup on initial load
			setupRevealObserver();

			// Re-setup after View Transitions
			document.addEventListener('astro:after-swap', () => {
				setupRevealObserver();
			});
		</script>
	</body>
</html>
