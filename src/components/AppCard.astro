---
// src/components/AppCard.astro
import { Image } from 'astro:assets';
import favicon from '../../public/favicon.svg';
export interface Props {
  href: string;
  name: string;
  status: {
    label: string;
    color: 'emerald' | 'blue' | 'yellow';
  };
  description: string;
  requirements: string;
  size: string;
  iconBgColor?: string; // e.g., 'from-purple-500 to-pink-500' - if not provided, uses image
  iconImage?: string; // e.g., '/favicon.svg'
}

const { href, name, status, description, requirements, size, iconBgColor, iconImage } = Astro.props;

const statusColors = {
  emerald: 'bg-emerald-400/15 text-emerald-700 dark:text-emerald-200 ring-1 ring-emerald-400/25',
  blue: 'bg-sky-400/15 text-sky-700 dark:text-sky-200 ring-1 ring-sky-400/25',
  yellow: 'bg-amber-400/15 text-amber-700 dark:text-amber-200 ring-1 ring-amber-400/25',
};

// Map primary colors for shadows based on status color to keep it simple but vibrant
const shadowColors = {
  emerald: 'hover:shadow-emerald-500/10',
  blue: 'hover:shadow-sky-500/10',
  yellow: 'hover:shadow-amber-500/10'
};
---

<a href={href} class="block">
  <div class={`liquid-card p-4 sm:p-5 md:p-6 transition-[transform,background-color,box-shadow,color] duration-300 hover:-translate-y-1 hover:shadow-2xl ${shadowColors[status.color]} group h-full flex flex-col`}>
    <div class="flex items-center space-x-3 sm:space-x-4 mb-3 sm:mb-4">
      {iconImage ? (
        <Image src={favicon} alt={name} class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl group-hover:scale-110 transition-[transform,color] duration-300" />
      ) : (
        <div class={`w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br ${iconBgColor} rounded-2xl flex items-center justify-center group-hover:scale-110 transition-[transform,color] duration-300 shadow-lg shadow-slate-900/10`}>
          <slot name="icon" />
        </div>
      )}
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-950 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-200 transition-colors font-display">{name}</h3>
        <span class={`inline-block px-2.5 py-1 text-[11px] font-bold rounded-full ${statusColors[status.color]}`}>{status.label}</span>
      </div>
    </div>
    <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mb-3 sm:mb-4 leading-relaxed flex-grow">
      {description}
    </p>
    <div class="flex items-center justify-between gap-3 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-auto font-mono">
      <span>{requirements}</span>
      <span>{size}</span>
    </div>
  </div>
</a>
