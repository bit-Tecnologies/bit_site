---
// src/components/AppCard.astro
import { Image } from 'astro:assets';
import favicon from '../../public/favicon.svg';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
export interface Props {
  href: string;
  name: string;
  status: {
    label: string;
    color: 'emerald' | 'blue' | 'yellow';
  };
  description: string;
  requirements: string;
  size: string;
  iconBgColor?: string; // e.g., 'from-purple-500 to-pink-500' - if not provided, uses image
  iconImage?: string; // e.g., '/favicon.svg'
  featured?: boolean;
}

const { href, name, status, description, requirements, size, iconImage, featured = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const statusColors = {
  emerald: 'bg-emerald-50 text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-300',
  blue: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
  yellow: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
};
---

<a href={href} class="block">
  <div class={`quiet-card p-5 sm:p-6 transition-[transform,border-color,background-color] duration-200 group h-full flex flex-col ${featured ? 'quiet-card-featured' : ''}`}>
    <div class="flex items-center space-x-3 sm:space-x-4 mb-3 sm:mb-4">
      {iconImage ? (
        <Image src={favicon} alt={name} class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl transition-transform duration-200 group-hover:scale-105" />
      ) : (
        <div class="app-card-icon w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-105">
          <slot name="icon" />
        </div>
      )}
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-[var(--ink)] group-hover:text-[var(--accent-strong)] transition-colors font-display">{name}</h3>
        <span class={`inline-block px-2 py-1 text-[10px] font-bold uppercase tracking-[0.12em] rounded-md ${statusColors[status.color]}`}>{status.label}</span>
      </div>
    </div>
    <p class="text-sm sm:text-base text-[var(--ink-muted)] mb-3 sm:mb-4 leading-relaxed flex-grow">
      {description}
    </p>
    <div class="flex items-center justify-between gap-3 text-xs sm:text-sm text-[var(--ink-muted)] mt-auto font-mono border-t border-[var(--line)] pt-4">
      <span>{requirements}</span>
      <span class="text-[var(--ink)]">{size}</span>
    </div>
    <span class="mt-4 text-sm font-bold text-[var(--accent-strong)]">{featured ? t('app.download') : t('app.view_product')} <span aria-hidden="true">→</span></span>
  </div>
</a>
