---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<div class="dynamic-lang-picker-container relative inline-block" data-initial-lang={lang}>
  <button
    type="button"
    class="dynamic-lang-menu-button language-control quiet-control inline-flex items-center justify-center gap-2 no-select focus-visible"
    aria-label="Change language"
  >
    <span class="sr-only">Change language</span>
    <span class="flex items-center gap-2 font-medium text-sm" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
      </svg>
      <span class="current-lang-display uppercase">{lang}</span>
    </span>
  </button>
</div>

<script>
  function setupLanguageToggle() {
    document.querySelectorAll<HTMLButtonElement>('.dynamic-lang-menu-button').forEach((button) => {
      button.onclick = (event: MouseEvent) => {
        event.preventDefault();
        const current = document.documentElement.lang === 'en' ? 'en' : 'ru';
        window.setLanguage?.(current === 'ru' ? 'en' : 'ru');
      };
    });
  }

  setupLanguageToggle();
  document.addEventListener('astro:after-swap', setupLanguageToggle);
</script>
