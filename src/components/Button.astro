---
// src/components/Button.astro
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  class?: string;
  download?: boolean;
  target?: string;
  rel?: string;
  title?: string;
  ariaLabel?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', class: className = '', download = false, target, rel, title, ariaLabel, ...rest } = Astro.props;

const baseStyles = "inline-flex items-center justify-center space-x-2 px-4 sm:px-6 lg:px-7 py-2.5 sm:py-3 font-bold rounded-[0.8rem] transition-[transform,background-color,border-color,color] duration-200 min-h-[44px] touch-manipulation";

const variants = {
  primary: "border border-emerald-600 bg-emerald-600 text-white shadow-sm hover:-translate-y-0.5 hover:bg-emerald-700 hover:border-emerald-700 active:translate-y-0 dark:border-emerald-400 dark:bg-emerald-400 dark:text-slate-950 dark:hover:bg-emerald-300",
  secondary: "border border-slate-200 bg-white text-slate-950 shadow-sm hover:-translate-y-0.5 hover:border-emerald-500 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:border-emerald-400",
  outline: "border border-slate-300 bg-transparent text-slate-800 hover:-translate-y-0.5 hover:border-emerald-600 hover:text-emerald-700 active:translate-y-0 dark:border-slate-700 dark:text-slate-100 dark:hover:border-emerald-400 dark:hover:text-emerald-300",
  ghost: "text-slate-700 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-300 active:scale-[0.98]"
};
---

<a
  href={href}
  class={`${baseStyles} ${variants[variant]} ${className}`}
  download={download ? '' : undefined}
  target={target}
  rel={rel}
  title={title}
  aria-label={ariaLabel}
  {...rest}
>
  <slot />
</a>
