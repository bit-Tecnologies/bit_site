---
// src/components/Button.astro
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  class?: string;
  download?: boolean;
  target?: string;
  rel?: string;
  title?: string;
  ariaLabel?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', class: className = '', download = false, target, rel, title, ariaLabel, ...rest } = Astro.props;

const baseStyles = "inline-flex items-center justify-center space-x-2 px-4 sm:px-6 lg:px-7 py-2.5 sm:py-3 font-bold rounded-[0.8rem] transition-[transform,background-color,border-color,color] duration-200 min-h-[44px] touch-manipulation";

const variants = {
  primary: "button-primary shadow-sm hover:-translate-y-0.5 active:translate-y-0",
  secondary: "button-secondary shadow-sm hover:-translate-y-0.5",
  outline: "button-outline hover:-translate-y-0.5 active:translate-y-0",
  ghost: "button-ghost active:scale-[0.98]"
};
---

<a
  href={href}
  class={`${baseStyles} ${variants[variant]} ${className}`}
  download={download ? '' : undefined}
  target={target}
  rel={rel}
  title={title}
  aria-label={ariaLabel}
  {...rest}
>
  <slot />
</a>
