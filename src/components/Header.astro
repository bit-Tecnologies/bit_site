---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import DynamicLanguagePicker from './DynamicLanguagePicker.astro';
import { Image } from 'astro:assets';
import favicon from '../../public/favicon.svg';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translate = translatePath(Astro.url);
---

<header class="fixed left-0 right-0 top-3 sm:top-4 z-50 transition-colors duration-300">
  <nav class="container mx-auto px-3 sm:px-4">
    <div class="quiet-nav flex items-center justify-between px-3 py-2.5 sm:px-4">
      <a href={translate('/')} class="flex min-w-0 flex-row items-center space-x-2" aria-label="bit Tecnologies">
        <Image src={favicon} alt="bit Tecnologies" class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl" />
        <span class="truncate text-base sm:text-lg font-extrabold font-display text-slate-950 dark:text-white max-[380px]:text-[0.9rem]">
          bit Tecnologies
        </span>
      </a>
      <div class="hidden md:flex items-center gap-4 sm:gap-5">
        <a href={translate('/#apps')} class="quiet-nav-link" data-i18n="nav.products">{t('nav.products')}</a>
        <a href={translate('/about')} class="quiet-nav-link" data-i18n="nav.about">{t('nav.about')}</a>
        <a href="https://github.com/bit-Tecnologies" target="_blank" rel="noopener noreferrer" class="quiet-nav-link">GitHub</a>
        <a href={translate('/#download')} class="quiet-nav-cta" data-i18n="nav.download">{t('nav.download')}</a>
        <DynamicLanguagePicker />
        <ThemeToggle label={t('theme.toggle')} />
      </div>
      <!-- Mobile menu buttons -->
      <div class="mobile-header-actions md:hidden flex items-center gap-1 mobile-menu-fixed">
        <div class="relative z-[61]">
          <DynamicLanguagePicker />
        </div>
        <div class="relative z-[61]">
          <ThemeToggle label={t('theme.toggle')} />
        </div>
        <button type="button" class="text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white transition-colors min-h-[44px] min-w-[44px] p-2 relative z-[61] no-select focus-visible" id="mobile-menu-btn" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden quiet-mobile-menu mt-3 px-4 py-3 transition-[opacity,transform,visibility] duration-200 origin-top mobile-menu-animate">
      <div class="flex flex-col space-y-1 sm:space-y-2 pt-3 sm:pt-4">
        <a href={translate('/#apps')} class="quiet-mobile-link" data-i18n="nav.products">{t('nav.products')}</a>
        <a href={translate('/about')} class="quiet-mobile-link" data-i18n="nav.about">{t('nav.about')}</a>
        <a href="https://github.com/bit-Tecnologies" target="_blank" rel="noopener noreferrer" class="quiet-mobile-link">GitHub</a>
        <a href={translate('/#download')} class="quiet-mobile-link quiet-mobile-link-cta" data-i18n="nav.download">{t('nav.download')}</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Script runs once on initial load and stays active across View Transitions
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
      // Clean up old listeners (for ViewTransitions)
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      const setMenuState = (open: boolean, returnFocus = false) => {
        newBtn.setAttribute('aria-expanded', String(open));
        newBtn.setAttribute('aria-label', open ? 'Close menu' : 'Toggle menu');

        if (open) {
          // Show menu with animation
          menu.classList.remove('hidden');
          menu.classList.add('scale-y-0', 'opacity-0');
          // Force reflow
          void menu.offsetHeight;
          menu.classList.remove('scale-y-0', 'opacity-0');
          menu.classList.add('scale-y-100', 'opacity-100');
        } else {
          // Hide menu with animation
          menu.classList.remove('scale-y-100', 'opacity-100');
          menu.classList.add('scale-y-0', 'opacity-0');
          setTimeout(() => {
            menu.classList.add('hidden');
            menu.classList.remove('scale-y-0', 'opacity-0');
          }, 300);
          if (returnFocus) newBtn.focus();
        }
      };

      newBtn.addEventListener('click', () => {
        setMenuState(menu.classList.contains('hidden'));
      });

      // Close mobile menu when clicking on a link
      const menuLinks = document.querySelectorAll('#mobile-menu a');
      menuLinks.forEach(link => {
        const newLink = link.cloneNode(true);
        link.parentNode?.replaceChild(newLink, link);

        const handleLinkClick = () => {
          setMenuState(false);
        };

        newLink.addEventListener('click', handleLinkClick);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.classList.contains('hidden')) setMenuState(false, true);
      });
    }
  }

  // Setup on initial load
  setupMobileMenu();

  // Setup after each View Transition
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
