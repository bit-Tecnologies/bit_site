---
// src/components/ThemeToggle.astro
interface Props {
  label?: string;
}
const { label = 'Toggle theme' } = Astro.props;
---

<button type="button" class="theme-toggle quiet-control no-select focus-visible" aria-label={label} title={label}>
  <span class="relative block w-5 h-5">
    <svg class="theme-toggle-dark-icon absolute inset-0 w-5 h-5 opacity-100 scale-100 blur-0 transition-[opacity,transform,filter] duration-300 ease-out" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
    <svg class="theme-toggle-light-icon absolute inset-0 w-5 h-5 opacity-0 scale-25 blur-[4px] transition-[opacity,transform,filter] duration-300 ease-out" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
  </span>
</button>

<script>
  const themeKey = 'color-theme';

  function getThemePreference(): 'system' | 'light' | 'dark' {
    const stored = localStorage.getItem(themeKey);
    return stored === 'light' || stored === 'dark' ? stored : 'system';
  }

  function isDarkPreference(preference: 'system' | 'light' | 'dark') {
    return preference === 'dark' || (preference === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  }

  function applyThemePreference() {
    document.documentElement.classList.toggle('dark', isDarkPreference(getThemePreference()));
  }

  function syncThemeToggle() {
    applyThemePreference();
    const isDark = document.documentElement.classList.contains('dark');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

    buttons.forEach((themeToggleBtn) => {
      const themeToggleDarkIcon = themeToggleBtn.querySelector('.theme-toggle-dark-icon');
      const themeToggleLightIcon = themeToggleBtn.querySelector('.theme-toggle-light-icon');

      if (!themeToggleDarkIcon || !themeToggleLightIcon) return;

      if (isDark) {
        themeToggleLightIcon.classList.remove('opacity-0', 'scale-25', 'blur-[4px]');
        themeToggleLightIcon.classList.add('opacity-100', 'scale-100', 'blur-0');
        themeToggleDarkIcon.classList.remove('opacity-100', 'scale-100', 'blur-0');
        themeToggleDarkIcon.classList.add('opacity-0', 'scale-25', 'blur-[4px]');
      } else {
        themeToggleDarkIcon.classList.remove('opacity-0', 'scale-25', 'blur-[4px]');
        themeToggleDarkIcon.classList.add('opacity-100', 'scale-100', 'blur-0');
        themeToggleLightIcon.classList.remove('opacity-100', 'scale-100', 'blur-0');
        themeToggleLightIcon.classList.add('opacity-0', 'scale-25', 'blur-[4px]');
      }

      themeToggleBtn.onclick = (e: MouseEvent) => {
        e.preventDefault();
        const preference = getThemePreference();
        const nextPreference = preference === 'system' ? 'dark' : preference === 'dark' ? 'light' : 'system';
        localStorage.setItem(themeKey, nextPreference);
        syncThemeToggle();
      };
    });
  }

  // Setup on initial load
  syncThemeToggle();

  const themeWindow = window as unknown as { __bitSystemThemeListener?: boolean };
  if (!themeWindow.__bitSystemThemeListener) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getThemePreference() === 'system') syncThemeToggle();
    });
    themeWindow.__bitSystemThemeListener = true;
  }
  // Sync after each View Transition (Layout.astro handles the html class)
  document.addEventListener('astro:after-swap', syncThemeToggle);
</script>
